# Microsoft Foundry project
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-resource>.services.ai.azure.com/api/projects/<project>
# Foundry resource key for VoiceLive; project SDK clients use Entra credentials.
FOUNDRY_API_KEY=
FOUNDRY_MODEL=gpt-5.5
FOUNDRY_EMBEDDING_MODEL=text-embedding-3-small

# OPTIONAL: set only when VoiceLive uses a different Foundry resource/project.
# By default, endpoint/key/model derive from the FOUNDRY_* values above.
# AZURE_VOICELIVE_ENDPOINT=https://<other-foundry-resource>.services.ai.azure.com
# AZURE_VOICELIVE_API_KEY=
# AZURE_VOICELIVE_MODEL=

# VoiceLive model source. Unset = a Voice Live-managed model, which must be one of the
# pre-deployed identifiers (gpt-realtime, gpt-realtime-mini, gpt-5, gpt-4.1, ...); set
# AZURE_VOICELIVE_MODEL above when that differs from FOUNDRY_MODEL.
# Set the profile below to reach a deployment you own instead. FOUNDRY_MODEL above is not
# pre-deployed by Voice Live, so this scaffold ships the BYOM path.
AZURE_VOICELIVE_PROFILE=byom-azure-openai-chat-completion

# Azure AI Search resource
AZURE_SEARCH_ENDPOINT=https://<search-service>.search.windows.net
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX_NAME=
AZURE_SEARCH_API_VERSION=2026-04-01
# Optional trusted OData filter for this local single-user process.
# Production filters must come from authenticated session state, never the transcript.
# AZURE_SEARCH_FILTER=organizations/any(item: item eq 'Contoso')
